{
  "name": "pointille",
  "version": "0.1.0",
  "description": "Distribute N points approximately evenly inside a polygon, deterministically, via Lloyd's algorithm on a centroidal Voronoi tessellation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test 'src/__tests__/*.test.ts'",
    "test:demo": "tsx scripts/demo.ts"
  },
  "keywords": [
    "polygon",
    "voronoi",
    "lloyd",
    "centroidal-voronoi-tessellation",
    "cvt",
    "point-distribution",
    "halton",
    "deterministic"
  ],
  "author": "Philihp Busby <philihp@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.7",
    "@types/d3-delaunay": "^6.0.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
